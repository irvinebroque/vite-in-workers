{
  "name": "vite-in-workers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "typecheck": "cf workers types && tsc",
    "prepare:runtime": "node scripts/prepare.js",
    "test": "npm run prepare:runtime && npm run typecheck && node scripts/verify.js",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "deploy": "npm run prepare:runtime && cf deploy",
    "token": "node scripts/create-token.js",
    "demo:backend": "npm run demo -- --backend",
    "dev": "npm run prepare:runtime && cf dev",
    "demo": "npm run prepare:runtime && node scripts/demo.js",
    "build:rolldown": "node toolchain/build.js",
    "check:toolchain": "node toolchain/check.js",
    "build": "npm run prepare:runtime && cf build"
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@rolldown/browser": "1.2.15",
    "@tybys/wasm-util": "0.10.3",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.7",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "cf": "1.0.0-beta.25",
    "emnapi": "2.0.0-alpha.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@rolldown/browser": {
      "@napi-rs/wasm-runtime": "1.2.5"
    }
  }
}
